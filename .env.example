# PRODUCTION CONFIGURATION
# Copy this file to .env and update with your production domain

# Allowed origins for CORS (comma-separated)
# For development: http://localhost:5000,http://127.0.0.1:5000
# For production: https://yourdomain.com,https://www.yourdomain.com
ALLOWED_ORIGINS=http://localhost:5000,http://127.0.0.1:5000

# Audio separation: auto tries Modal-Rotation when configured, then direct Modal,
# then local Demucs. Use control-plane to require routed multi-workspace compute.
AUDIO_SEPARATOR_BACKEND=auto
AUDIO_SEPARATOR_MODAL_APP=mediakeepa-audio-separator
AUDIO_SEPARATOR_MODAL_FUNCTION=separate_audio
AUDIO_SEPARATOR_MODAL_CLASS=AudioSeparator
AUDIO_SEPARATOR_MODAL_METHOD=separate

# Optional local Modal-Rotation control plane. It currently binds to loopback and
# should not be exposed publicly. Register mediakeepa / separate-audio first.
AUDIO_SEPARATOR_CONTROL_PLANE_URL=
AUDIO_SEPARATOR_CONTROL_PLANE_APPLICATION=mediakeepa
AUDIO_SEPARATOR_CONTROL_PLANE_WORKLOAD=separate-audio
AUDIO_SEPARATOR_CONTROL_PLANE_ESTIMATED_COST_USD=0.50
AUDIO_SEPARATOR_CONTROL_PLANE_TIMEOUT_SECONDS=1800

# Image-only Background Remover powered by self-hosted Bria RMBG-2.0 on Modal.
BACKGROUND_REMOVER_BACKEND=auto
BACKGROUND_REMOVER_MODAL_APP=mediakeepa-background-remover
BACKGROUND_REMOVER_MODAL_FUNCTION=remove_background
BACKGROUND_REMOVER_MODAL_CLASS=BackgroundRemover
BACKGROUND_REMOVER_MODAL_METHOD=remove

BACKGROUND_REMOVER_CONTROL_PLANE_URL=
BACKGROUND_REMOVER_CONTROL_PLANE_APPLICATION=mediakeepa
BACKGROUND_REMOVER_CONTROL_PLANE_WORKLOAD=remove-background
BACKGROUND_REMOVER_CONTROL_PLANE_ESTIMATED_COST_USD=0.05
BACKGROUND_REMOVER_CONTROL_PLANE_TIMEOUT_SECONDS=300

# Modal worker deployment tuning. Fast mode reserves one always-warm worker
# for each tool. Use set-mediakeepa-performance.ps1 to apply these safely.
MEDIAKEEPA_AUDIO_GPU=L40S
MEDIAKEEPA_AUDIO_MIN_CONTAINERS=1
MEDIAKEEPA_AUDIO_BUFFER_CONTAINERS=0
MEDIAKEEPA_AUDIO_SCALEDOWN_WINDOW=1200
MEDIAKEEPA_BACKGROUND_GPU=L4
MEDIAKEEPA_BACKGROUND_MIN_CONTAINERS=1
MEDIAKEEPA_BACKGROUND_BUFFER_CONTAINERS=0
MEDIAKEEPA_BACKGROUND_SCALEDOWN_WINDOW=1200

# For production only, set these securely in the hosting provider's environment.
# Never commit real Modal credentials.
MODAL_TOKEN_ID=
MODAL_TOKEN_SECRET=
